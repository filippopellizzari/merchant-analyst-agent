SHELL := /bin/bash
JAVA_HOME ?= $(shell brew --prefix openjdk@21 2>/dev/null)/libexec/openjdk.jdk/Contents/Home
export JAVA_HOME

.PHONY: help proto service-build service-test service-run agent-sync agent-test agent-cli agent-web eval eval-test test

help: ## Show targets
	@grep -E '^[a-zA-Z_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-14s %s\n", $$1, $$2}'

proto: ## Regenerate Python gRPC stubs from proto/ (Java stubs are generated by Maven)
	cd agent && uv run python -m grpc_tools.protoc -I../proto \
		--python_out=merchant_analyst/pb --grpc_python_out=merchant_analyst/pb --pyi_out=merchant_analyst/pb \
		../proto/merchant/v1/analyst.proto
	cd agent && uv run python scripts/fix_pb_imports.py

service-build: ## Build the Java tool service
	cd tool-service && ./mvnw -q -DskipTests package

service-test: ## Run Java unit tests (no cloud needed)
	cd tool-service && ./mvnw -q test

service-run: ## Run the tool service locally (needs GCP_PROJECT + ADC)
	cd tool-service && ./mvnw -q -DskipTests exec:java

agent-sync: ## Install Python deps
	cd agent && uv sync --all-groups

agent-test: ## Run Python unit tests for the agent
	cd agent && uv run pytest -q

agent-cli: ## Ask one question: make agent-cli Q="top 5 products in Dec 2020"
	cd agent && uv run python -m merchant_analyst.cli "$(Q)"

agent-web: ## Launch the ADK dev UI
	cd agent && uv run adk web agents

eval: ## Run the eval harness (needs service + Gemini key)
	cd agent && uv run python -m merchant_eval.run $(ARGS)

eval-test: ## Unit tests for the eval extractor/matcher (offline)
	cd agent && uv run pytest -q tests/eval

test: service-test agent-test ## All offline tests
