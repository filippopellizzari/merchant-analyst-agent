# --- Tool service (Java) ---
# GCP project that BigQuery queries are billed to (public dataset reads use free tier).
GCP_PROJECT=your-gcp-project-id
TOOL_SERVICE_PORT=50051
# Safety guard: BigQuery rejects queries that would scan more than this (bytes).
BQ_MAX_BYTES_BILLED=2000000000
BQ_USE_CACHE=true

# --- Agent (Python) ---
GOOGLE_API_KEY=your-ai-studio-key
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-2.5-flash
TOOL_SERVICE_ADDRESS=localhost:50051
